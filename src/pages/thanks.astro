---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Thank you" description="Thanks for reaching out to Solidara.">
  <section class="thanks">
    <div class="container narrow">
      <h1>Thank you</h1>
      <p>
        We've received what you shared, and we'll get back to you soon.
        In the meantime, feel free to look around.
      </p>
      <a class="button button-primary" href="/">Back to home</a>
    </div>
  </section>

  <style>
    .thanks {
      padding-block: 96px 120px;
      text-align: left;
    }
    .narrow {
      max-width: 560px;
    }
    .thanks h1 {
      font-size: 32px;
      margin-bottom: 16px;
    }
    .thanks p {
      font-size: 16px;
      margin-bottom: 28px;
    }
  </style>
</BaseLayout>
