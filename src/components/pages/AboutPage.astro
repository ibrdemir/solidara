---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getT, routes, alternatesFor } from '../../i18n/index.js';

const { lang = 'en' } = Astro.props;
const t = getT(lang);
const a = t.about;
---

<BaseLayout title={a.title} description={a.description} lang={lang} alternates={alternatesFor('about')}>
  <section class="about-header">
    <div class="container narrow">
      <h1>{a.heading}</h1>
    </div>
  </section>

  <section class="about-content">
    <div class="container narrow">
      {a.intro.map((para) => <p set:html={para} />)}
    </div>
  </section>

  <section class="about-image">
    <div class="container">
      <img
        src="/images/about-story.jpg"
        alt=""
        width="1600"
        height="900"
      />
    </div>
  </section>

  <section class="about-content">
    <div class="container narrow">
      <p set:html={a.belief} />
    </div>
  </section>

  <blockquote class="pull-quote">
    <div class="container narrow">
      <p>{a.pullQuote}</p>
    </div>
  </blockquote>

  <section class="about-content">
    <div class="container narrow">
      {a.rest.map((para) => <p set:html={para} />)}
      <p class="cta-line"><a href={routes.shape[lang]}>{a.cta} &rarr;</a></p>
    </div>
  </section>

  <style>
    .narrow {
      max-width: 640px;
    }

    .about-header {
      padding-block: 64px 8px;
    }
    .about-header h1 {
      font-size: 34px;
    }

    .about-content {
      padding-block: 24px;
    }
    .about-content p {
      font-size: 16px;
      margin-bottom: 20px;
    }
    .about-content p:last-child {
      margin-bottom: 0;
    }
    .about-content em {
      font-style: italic;
      color: var(--color-ink);
    }

    .about-image {
      padding-block: 24px;
    }
    .about-image img {
      width: 100%;
      border-radius: 12px;
      aspect-ratio: 16 / 9;
      height: auto;
      object-fit: cover;
    }

    .pull-quote {
      margin: 40px 0;
      padding-block: 44px;
      border-top: 1px solid var(--color-surface);
      border-bottom: 1px solid var(--color-surface);
    }
    .pull-quote p {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 26px;
      line-height: 1.4;
      color: var(--color-teal);
      margin: 0;
    }

    .cta-line {
      margin-top: 32px !important;
      font-weight: 500;
    }
    .cta-line a {
      color: var(--color-teal);
    }
    .cta-line a:hover {
      text-decoration: underline;
    }
  </style>
</BaseLayout>
