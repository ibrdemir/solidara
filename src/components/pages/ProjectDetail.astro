---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getT, routes, projectPath } from '../../i18n/index.js';

const { project, lang = 'en' } = Astro.props;
const t = getT(lang);
const L = t.projects.labels;
const p = project.data;
const other = lang === 'en' ? 'nl' : 'en';

// Diğer dilde karşılığı varsa dil değiştirici oraya gider
const counterpart = await getEntry(lang === 'nl' ? 'projects' : 'projectsNl', project.id);
const alternates = counterpart
  ? { en: projectPath('en', project.id), nl: projectPath('nl', project.id) }
  : undefined;

const switchHref = lang === 'en' ? p.callToAction?.hrefNl : p.callToAction?.hrefEn;

function formatDate(dateString) {
  const date = new Date(dateString);
  return date.toLocaleDateString(t.dateLocale, { month: 'short', year: 'numeric' });
}
---

<BaseLayout title={p.title} description={p.summary} lang={lang} alternates={alternates}>
  <section class="project-hero">
    <div class="container">
      <img src={p.image} alt="" width="1600" height="900" />
    </div>
  </section>

  <section class="project-header">
    <div class="container">
      <div class="tags">
        <span class="status-pill">{t.projects.status[p.status]}</span>
        <span class="activity-tag">{t.projects.activity[p.activity]}</span>
      </div>
      <h1>{p.title}</h1>
      {p.callToAction && (
        <div class="cta-wrap" data-hide-after={p.callToAction.deadline}>
          <a class="cta-banner" href={p.callToAction.href}>
            <span class="cta-label">{p.callToAction.label}</span>
            <span class="cta-title">{p.callToAction.title} <span class="cta-arrow">&rarr;</span></span>
            {p.callToAction.text && <span class="cta-text">{p.callToAction.text}</span>}
          </a>
          {switchHref && (
            <a class="cta-switch" href={switchHref} hreflang={other}>{t.projects.switchToOther} &rarr;</a>
          )}
        </div>
      )}
    </div>
  </section>

  <section class="project-content">
    <div class="container content-grid">
      <div class="main-column">
        <p class="lead">{p.summary}</p>

        <h2>{L.keyActivities}</h2>
        <ul class="dot-list">
          {p.keyActivities.map((item) => (
            <li>
              <span class="eyebrow-dot"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <h2>{L.whoFor}</h2>
        <p>{p.targetGroup}</p>
      </div>

      <aside class="fact-panel">
        <div class="fact-row">
          <span class="fact-label">{L.role}</span>
          <span class="fact-value">{t.projects.role[p.role]}</span>
        </div>
        <div class="fact-row">
          <span class="fact-label">{L.funding}</span>
          <span class="fact-value">{p.fundingProgramme}</span>
        </div>
        <div class="fact-row">
          <span class="fact-label">{L.coordinator}</span>
          <span class="fact-value">{p.coordinator}</span>
        </div>
        {p.partners.length > 0 && (
          <div class="fact-row">
            <span class="fact-label">{L.partners}</span>
            <span class="fact-value">
              {p.partners.map((partner) => (
                <span class="partner-line">
                  {partner.name}
                  {partner.country ? `, ${partner.country}` : ''}
                  {partner.note ? ` (${partner.note})` : ''}
                </span>
              ))}
            </span>
          </div>
        )}
        <div class="fact-row">
          <span class="fact-label">{L.duration}</span>
          <span class="fact-value">
            {formatDate(p.startDate)} – {formatDate(p.endDate)}
            {p.durationLabel ? ` (${p.durationLabel})` : ''}
          </span>
        </div>
        {p.phases.length > 0 && (
          <div class="fact-row">
            <span class="fact-label">{L.phases}</span>
            <span class="fact-value">
              {p.phases.map((phase) => (
                <span class="partner-line">{phase}</span>
              ))}
            </span>
          </div>
        )}
      </aside>
    </div>

    <div class="container">
      <a class="back-link" href={routes.projects[lang]}>&larr; {t.projects.back}</a>
    </div>
  </section>

  <style>
    .project-hero {
      padding-block: 32px 0;
    }
    .project-hero img {
      width: 100%;
      border-radius: 12px;
      aspect-ratio: 16 / 9;
      height: auto;
      object-fit: cover;
    }

    .project-header {
      padding-block: 24px 16px;
    }
    .tags {
      display: flex;
      gap: 6px;
      margin-bottom: 14px;
    }
    .status-pill {
      font-size: 11px;
      color: var(--color-slate);
      background: var(--color-surface);
      padding: 3px 10px;
      border-radius: 20px;
    }
    .activity-tag {
      font-size: 11px;
      color: var(--color-teal);
      background: rgba(0, 179, 204, 0.1);
      padding: 3px 10px;
      border-radius: 20px;
    }
    .cta-banner {
      display: block;
      margin-top: 28px;
      max-width: 720px;
      padding: 28px 32px;
      background: var(--color-surface);
      border-left: 5px solid var(--color-terracotta);
      border-radius: 4px 12px 12px 4px;
      transition: background 0.15s ease;
    }
    .cta-banner:hover {
      background: #e9f0f2;
    }
    .cta-label {
      display: inline-block;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--color-terracotta);
      margin-bottom: 10px;
    }
    .cta-title {
      display: block;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 36px;
      line-height: 1.15;
      color: var(--color-ink);
    }
    .cta-arrow {
      color: var(--color-terracotta);
      display: inline-block;
      transition: transform 0.15s ease;
    }
    .cta-banner:hover .cta-arrow {
      transform: translateX(6px);
    }
    .cta-text {
      display: block;
      margin-top: 12px;
      font-size: 15px;
      color: var(--color-slate);
    }
    .cta-switch {
      display: inline-block;
      margin-top: 12px;
      font-size: 14px;
      font-weight: 500;
      color: var(--color-teal);
    }
    .cta-switch:hover {
      text-decoration: underline;
    }

    .project-header h1 {
      font-size: 30px;
      max-width: 700px;
    }

    .project-content {
      padding-block: 24px 32px;
    }
    .content-grid {
      display: grid;
      grid-template-columns: 1.6fr 1fr;
      gap: 48px;
      align-items: start;
    }
    .main-column .lead {
      font-size: 16px;
      margin-bottom: 32px;
    }
    .main-column h2 {
      font-size: 18px;
      margin-bottom: 14px;
      margin-top: 32px;
    }
    .main-column h2:first-of-type {
      margin-top: 0;
    }
    .main-column p {
      font-size: 14px;
    }
    .dot-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .dot-list li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 14px;
      color: var(--color-slate);
    }
    .dot-list .eyebrow-dot {
      margin-top: 7px;
      flex-shrink: 0;
    }

    .fact-panel {
      border: 1px solid var(--color-surface);
      border-radius: 12px;
      padding: 20px;
    }
    .fact-row {
      padding-block: 12px;
      border-top: 1px solid var(--color-surface);
    }
    .fact-row:first-child {
      border-top: none;
      padding-top: 0;
    }
    .fact-label {
      display: block;
      font-size: 11px;
      color: var(--color-slate);
      margin-bottom: 6px;
    }
    .fact-value {
      display: block;
      font-size: 13px;
      color: var(--color-ink);
      font-weight: 500;
    }
    .partner-line {
      display: block;
      font-weight: 400;
      margin-bottom: 4px;
    }
    .partner-line:last-child {
      margin-bottom: 0;
    }

    .back-link {
      display: inline-block;
      margin-top: 32px;
      font-size: 13px;
      color: var(--color-teal);
      font-weight: 500;
    }
    .back-link:hover {
      text-decoration: underline;
    }

    @media (max-width: 780px) {
      .content-grid {
        grid-template-columns: 1fr;
      }
      .cta-banner {
        padding: 22px 20px;
      }
      .cta-title {
        font-size: 26px;
      }
    }
  </style>
</BaseLayout>
