---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { announcement } from '../../data/announcement.js';
import { getT, routes, alternatesFor } from '../../i18n/index.js';

const { lang = 'en' } = Astro.props;
const t = getT(lang);
const other = lang === 'en' ? 'nl' : 'en';

const images = [
  '/images/teaser-belief.jpg',
  '/images/teaser-activities.jpg',
  '/images/teaser-shapewithus.jpg',
];
const hrefs = [routes.about[lang], routes.activities[lang], routes.shape[lang]];
const teasers = t.home.teasers.map((teaser, i) => ({
  ...teaser,
  image: images[i],
  href: hrefs[i],
  accent: i === 2,
}));
---

<BaseLayout title={t.home.title} lang={lang} alternates={alternatesFor('home')}>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1>{t.home.heroTitle}</h1>
        <p class="hero-lede">{t.home.heroLede}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={routes.about[lang]}>{t.home.readStory}</a>
          <a class="button button-secondary" href={routes.shape[lang]}>{t.home.shapeWithUs}</a>
        </div>
      </div>
      <div class="hero-media">
        <img src="/images/hero-home.jpg" alt={t.home.heroAlt} width="800" height="533" />
      </div>
    </div>
  </section>

  <section class="call-card-section" data-hide-after={announcement.hideAfter}>
    <div class="container">
      <div class="call-card">
        <a class="call-card-main" href={announcement[lang].href}>
          <span class="call-card-label">{t.home.callCard.label}</span>
          <span class="call-card-title">{t.home.callCard.title} <span class="call-card-arrow">&rarr;</span></span>
          <span class="call-card-text">{t.home.callCard.text}</span>
        </a>
        <a class="call-card-switch" href={announcement[lang].switchHref} hreflang={other}>{t.home.callCard.switchLabel} &rarr;</a>
      </div>
    </div>
  </section>

  <section class="teasers">
    <div class="container teaser-grid">
      {teasers.map((teaser) => (
        <a class:list={['teaser-card', { accent: teaser.accent }]} href={teaser.href}>
          <img src={teaser.image} alt="" width="900" height="900" />
          <div class="teaser-body">
            <span class="eyebrow-dot"></span>
            <h2>{teaser.heading}</h2>
            <p>{teaser.text}</p>
            <span class="teaser-link">{teaser.linkLabel} &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <style>
    .hero {
      padding-block: 64px 88px;
      background: var(--color-surface);
    }
    .hero-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 56px;
      align-items: center;
    }
    .hero-copy h1 {
      font-size: 48px;
      max-width: 480px;
    }
    .hero-lede {
      margin-top: 24px;
      font-size: 17px;
      max-width: 440px;
    }
    .hero-actions {
      display: flex;
      gap: 12px;
      margin-top: 32px;
      flex-wrap: wrap;
    }
    .hero-media img {
      border-radius: 12px;
      width: 100%;
      aspect-ratio: 3 / 2;
      height: auto;
      object-fit: cover;
    }

    .call-card-section {
      padding-block: 56px 0;
    }
    .call-card {
      background: var(--color-surface);
      border-left: 5px solid var(--color-terracotta);
      border-radius: 4px 12px 12px 4px;
      padding: 32px 36px;
    }
    .call-card-main {
      display: block;
    }
    .call-card-label {
      display: inline-block;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--color-terracotta);
      margin-bottom: 10px;
    }
    .call-card-title {
      display: block;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 34px;
      line-height: 1.15;
      color: var(--color-ink);
    }
    .call-card-arrow {
      color: var(--color-terracotta);
      display: inline-block;
      transition: transform 0.15s ease;
    }
    .call-card-main:hover .call-card-arrow {
      transform: translateX(6px);
    }
    .call-card-text {
      display: block;
      margin-top: 12px;
      max-width: 640px;
      font-size: 16px;
      color: var(--color-slate);
    }
    .call-card-switch {
      display: inline-block;
      margin-top: 16px;
      font-size: 14px;
      font-weight: 500;
      color: var(--color-teal);
    }
    .call-card-switch:hover {
      text-decoration: underline;
    }

    .teasers {
      padding-block: 88px;
    }
    .teaser-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
    .teaser-card {
      display: block;
      border: 1px solid var(--color-surface);
      border-radius: 12px;
      overflow: hidden;
      transition: border-color 0.15s ease;
    }
    .teaser-card:hover {
      border-color: var(--color-teal);
    }
    .teaser-card.accent:hover {
      border-color: var(--color-terracotta);
    }
    .teaser-card img {
      width: 100%;
      aspect-ratio: 4 / 3;
      height: auto;
      object-fit: cover;
    }
    .teaser-body {
      padding: 24px;
    }
    .teaser-body .eyebrow-dot {
      margin-bottom: 14px;
    }
    .teaser-card.accent .eyebrow-dot {
      background: var(--color-terracotta);
    }
    .teaser-body h2 {
      font-size: 19px;
      margin-bottom: 10px;
    }
    .teaser-body p {
      font-size: 14px;
    }
    .teaser-link {
      display: inline-block;
      margin-top: 16px;
      font-size: 13px;
      font-weight: 500;
      color: var(--color-teal);
    }
    .teaser-card.accent .teaser-link {
      color: var(--color-terracotta);
    }

    @media (max-width: 860px) {
      .call-card {
        padding: 24px 20px;
      }
      .call-card-title {
        font-size: 26px;
      }
      .hero-inner {
        grid-template-columns: 1fr;
      }
      .teaser-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
