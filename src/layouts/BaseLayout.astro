---
import '../styles/global.css';
import '@fontsource/sora/500.css';
import '@fontsource/sora/600.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import { announcement } from '../data/announcement.js';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'nl';
  showAnnouncement?: boolean;
  alternates?: { en?: string; nl?: string };
}

const {
  title,
  description = "Solidara supports people's learning for life, through digital skills, sustainable living, active citizenship, and lifelong learning.",
  lang = 'en',
  showAnnouncement = true,
  alternates,
} = Astro.props;

const bar = announcement[lang];
const site = Astro.site ?? new URL('https://solidara.org');

const navLinks = [
  { label: 'About us', href: '/about' },
  { label: 'Activities', href: '/activities' },
  { label: 'Projects', href: '/projects' },
  { label: 'Shape with us', href: '/shape-with-us' },
  { label: 'News', href: '/news' },
  { label: 'Contact us', href: '/contact' },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/images/logo.jpg" />
    <title>{title} · Solidara</title>
    <meta name="description" content={description} />
    {alternates?.en && <link rel="alternate" hreflang="en" href={new URL(alternates.en, site).href} />}
    {alternates?.nl && <link rel="alternate" hreflang="nl" href={new URL(alternates.nl, site).href} />}
  </head>
  <body>
    {showAnnouncement && (
      <div class="call-bar" id="call-bar" data-hide-after={announcement.hideAfter}>
        <div class="container call-bar-inner">
          <p>
            <span class="call-bar-label">{bar.label}</span>
            <span>{bar.text}</span>
            <a class="call-bar-link" href={bar.href}>{bar.cta} &rarr;</a>
          </p>
          <a class="call-bar-switch" href={bar.switchHref} hreflang={lang === 'en' ? 'nl' : 'en'}>{bar.switchLabel}</a>
          <button class="call-bar-close" id="call-bar-close" aria-label={lang === 'en' ? 'Close announcement' : 'Sluit melding'}>&times;</button>
        </div>
      </div>
    )}
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo-link">
          <img src="/images/logo.jpg" alt="Stichting Solidara" class="site-logo" width="220" />
        </a>
        <nav class="site-nav">
          {navLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
        <button
          class="menu-toggle"
          id="menu-toggle"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
      <nav class="mobile-nav" id="mobile-nav">
        {navLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand-block">
          <p class="footer-name">Solidara</p>
          <p class="footer-motto">People first, at every stage of life.</p>
        </div>
        <nav class="footer-nav">
          {navLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
        <div class="footer-social">
          <a href="#" aria-label="Solidara on Facebook" target="_blank" rel="noopener noreferrer">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="2" y="2" width="20" height="20" rx="6" />
              <text x="12" y="16.5" text-anchor="middle" font-size="12" font-weight="600" fill="currentColor" stroke="none">f</text>
            </svg>
          </a>
          <a href="https://www.instagram.com/stichtingsolidara" aria-label="Solidara on Instagram" target="_blank" rel="noopener noreferrer">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="2" y="2" width="20" height="20" rx="6" />
              <circle cx="12" cy="12" r="4.2" />
              <circle cx="16.3" cy="7.7" r="1" fill="currentColor" stroke="none" />
            </svg>
          </a>
          <a href="#" aria-label="Solidara on X" target="_blank" rel="noopener noreferrer">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
              <rect x="2" y="2" width="20" height="20" rx="6" />
              <line x1="8" y1="8" x2="16" y2="16" />
              <line x1="16" y1="8" x2="8" y2="16" />
            </svg>
          </a>
          <a href="#" aria-label="Solidara on LinkedIn" target="_blank" rel="noopener noreferrer">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="2" y="2" width="20" height="20" rx="6" />
              <text x="12" y="16.5" text-anchor="middle" font-size="10.5" font-weight="600" fill="currentColor" stroke="none">in</text>
            </svg>
          </a>
        </div>
      </div>
    </footer>

    <style>
      .call-bar {
        background: var(--color-ink);
        color: var(--color-white);
        font-size: 14px;
      }
      .call-bar-inner {
        display: flex;
        align-items: center;
        gap: 16px;
        padding-block: 10px;
      }
      .call-bar-inner p {
        flex: 1;
        margin: 0;
        color: var(--color-white);
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 4px 10px;
      }
      .call-bar-label {
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #F2A184;
      }
      .call-bar-link {
        color: var(--color-white);
        font-weight: 500;
        text-decoration: underline;
        white-space: nowrap;
      }
      .call-bar-switch {
        color: var(--color-white);
        opacity: 0.8;
        font-size: 13px;
        white-space: nowrap;
      }
      .call-bar-switch:hover {
        opacity: 1;
      }
      .call-bar-close {
        background: transparent;
        border: none;
        color: var(--color-white);
        font-size: 22px;
        line-height: 1;
        cursor: pointer;
        padding: 0 4px;
        opacity: 0.8;
      }
      .call-bar-close:hover {
        opacity: 1;
      }
      .site-header {
        border-bottom: 1px solid var(--color-surface);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: 20px;
        gap: 24px;
        flex-wrap: wrap;
      }
      .logo-link img {
        background: transparent;
      }
      .site-logo {
        width: 220px;
        height: auto;
      }
      .site-nav {
        display: flex;
        gap: 28px;
        font-size: 16px;
      }
      .site-nav a:hover {
        color: var(--color-teal);
      }
      .menu-toggle {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 32px;
        height: 32px;
        padding: 0;
        border: none;
        background: transparent;
        cursor: pointer;
      }
      .menu-toggle span {
        display: block;
        width: 100%;
        height: 2px;
        background: var(--color-ink);
        transition: transform 0.2s ease, opacity 0.2s ease;
      }
      .menu-toggle[aria-expanded="true"] span:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
      }
      .menu-toggle[aria-expanded="true"] span:nth-child(2) {
        opacity: 0;
      }
      .menu-toggle[aria-expanded="true"] span:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
      }
      .mobile-nav {
        display: none;
        flex-direction: column;
        border-top: 1px solid var(--color-surface);
        padding: 8px 24px 20px;
      }
      .mobile-nav a {
        padding-block: 12px;
        font-size: 15px;
        border-bottom: 1px solid var(--color-surface);
      }
      .mobile-nav a:last-child {
        border-bottom: none;
      }
      .mobile-nav.is-open {
        display: flex;
      }
      .site-footer {
        background: #007E8F;
        margin-top: 96px;
      }
      .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: 40px;
        gap: 24px;
        flex-wrap: wrap;
      }
      .footer-brand-block {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .footer-name {
        font-family: var(--font-display);
        font-size: 20px;
        font-weight: 600;
        color: var(--color-white);
        margin: 0;
      }
      .footer-motto {
        font-family: var(--font-display);
        font-size: 15px;
        font-weight: 500;
        color: var(--color-white);
        opacity: 0.9;
        margin: 0;
      }
      .footer-nav {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        font-size: 13px;
      }
      .footer-nav a {
        color: var(--color-white);
        opacity: 0.85;
      }
      .footer-nav a:hover {
        opacity: 1;
      }
      .footer-social {
        display: flex;
        gap: 14px;
      }
      .footer-social a {
        color: var(--color-white);
        opacity: 0.9;
        display: inline-flex;
      }
      .footer-social a:hover {
        opacity: 1;
      }
      @media (max-width: 640px) {
        .site-nav {
          display: none;
        }
        .menu-toggle {
          display: flex;
        }
        .site-logo {
          width: 160px;
        }
      }
    </style>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const mobileNav = document.getElementById('mobile-nav');
      toggle?.addEventListener('click', () => {
        const isOpen = mobileNav?.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
      });

      // Son tarihten sonra data-hide-after taşıyan her şeyi gizle
      const now = Date.now();
      document.querySelectorAll('[data-hide-after]').forEach((el) => {
        const t = Date.parse(el.getAttribute('data-hide-after'));
        if (!Number.isNaN(t) && now > t) el.style.display = 'none';
      });

      // Duyuru çubuğunu kapatma (hatırlanır)
      const callBar = document.getElementById('call-bar');
      try {
        if (localStorage.getItem('callBarDismissed') === '1' && callBar) {
          callBar.style.display = 'none';
        }
      } catch (e) {}
      document.getElementById('call-bar-close')?.addEventListener('click', () => {
        if (callBar) callBar.style.display = 'none';
        try { localStorage.setItem('callBarDismissed', '1'); } catch (e) {}
      });
    </script>
  </body>
</html>
