---
import '../styles/global.css';
import '@fontsource/sora/500.css';
import '@fontsource/sora/600.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Solidara supports people's learning for life, through digital skills, sustainable living, active citizenship, and lifelong learning.",
} = Astro.props;

const navLinks = [
  { label: 'About us', href: '/about' },
  { label: 'Activities', href: '/activities' },
  { label: 'Projects', href: '/projects' },
  { label: 'Shape with us', href: '/shape-with-us' },
  { label: 'News', href: '/news' },
  { label: 'Contact us', href: '/contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/images/logo.jpg" />
    <title>{title} · Solidara</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo-link">
          <img src="/images/logo.jpg" alt="Stichting Solidara" width="140" />
        </a>
        <nav class="site-nav">
          {navLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand-block">
          <p class="footer-name">Solidara</p>
          <p class="footer-motto">People first, at every stage of life.</p>
        </div>
        <nav class="footer-nav">
          {navLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
        <div class="footer-social">
          <a href="#" aria-label="Solidara on Facebook" target="_blank" rel="noopener noreferrer">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="2" y="2" width="20" height="20" rx="6" />
              <text x="12" y="16.5" text-anchor="middle" font-size="12" font-weight="600" fill="currentColor" stroke="none">f</text>
            </svg>
          </a>
          <a href="#" aria-label="Solidara on Instagram" target="_blank" rel="noopener noreferrer">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="2" y="2" width="20" height="20" rx="6" />
              <circle cx="12" cy="12" r="4.2" />
              <circle cx="16.3" cy="7.7" r="1" fill="currentColor" stroke="none" />
            </svg>
          </a>
          <a href="#" aria-label="Solidara on X" target="_blank" rel="noopener noreferrer">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
              <rect x="2" y="2" width="20" height="20" rx="6" />
              <line x1="8" y1="8" x2="16" y2="16" />
              <line x1="16" y1="8" x2="8" y2="16" />
            </svg>
          </a>
        </div>
      </div>
    </footer>

    <style>
      .site-header {
        border-bottom: 1px solid var(--color-surface);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: 20px;
        gap: 24px;
        flex-wrap: wrap;
      }
      .logo-link img {
        background: transparent;
      }
      .site-nav {
        display: flex;
        gap: 28px;
        font-size: 14px;
      }
      .site-nav a:hover {
        color: var(--color-teal);
      }
      .site-footer {
        background: var(--color-teal);
        margin-top: 96px;
      }
      .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: 40px;
        gap: 24px;
        flex-wrap: wrap;
      }
      .footer-brand-block {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .footer-name {
        font-family: var(--font-display);
        font-size: 20px;
        font-weight: 600;
        color: var(--color-ink);
        margin: 0;
      }
      .footer-motto {
        font-family: var(--font-display);
        font-size: 15px;
        font-weight: 500;
        color: var(--color-ink);
        opacity: 0.85;
        margin: 0;
      }
      .footer-nav {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        font-size: 13px;
      }
      .footer-nav a {
        color: var(--color-ink);
        opacity: 0.75;
      }
      .footer-nav a:hover {
        opacity: 1;
      }
      .footer-social {
        display: flex;
        gap: 12px;
      }
      .footer-social a {
        color: var(--color-ink);
        opacity: 0.75;
        display: inline-flex;
      }
      .footer-social a:hover {
        opacity: 1;
      }
      @media (max-width: 640px) {
        .site-nav {
          display: none;
        }
      }
    </style>
  </body>
</html>
